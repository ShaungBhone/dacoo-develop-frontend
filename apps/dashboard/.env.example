# Server-side Laravel API origin used by the documentation SSO bridge.
API_URL=https://https://srv1713705.hstgr.cloud

# Browser-accessible Laravel API origin used by the dashboard.
NEXT_PUBLIC_API_URL=

# Public documentation origin.
NEXT_PUBLIC_DOCS_URL=http://docs.localhost:3001

# Laravel Reverb application key. This value is public by design.
NEXT_PUBLIC_REVERB_APP_KEY=maychat

# Optional public WebSocket endpoint (hostname only, without https://).
# Defaults to the API hostname, HTTPS/443 or HTTP/8080. Set before building.
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=
NEXT_PUBLIC_REVERB_SCHEME=
