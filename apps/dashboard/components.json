{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@reui": "https://reui.io/r/{style}/{name}.json",
    "@tailark": "https://tailark.com/r/{name}.json",
    "@ss-components": "https://shadcnstudio.com/r/base-vega/{name}.json",
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@lucide-animated": "https://lucide-animated.com/r/{name}.json",
    "@snapcn": "https://snapcn.dev/r/{name}.json"
  }
}
