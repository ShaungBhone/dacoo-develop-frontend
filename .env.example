# Complete frontend environment reference.
# Copy the relevant app section to apps/dashboard/.env.local or apps/docs/.env.local.

# Dashboard
API_URL=https://maychat.test
NEXT_PUBLIC_API_URL=https://maychat.test
NEXT_PUBLIC_DOCS_URL=http://docs.localhost:3001
NEXT_PUBLIC_REVERB_APP_KEY=maychat

# Documentation
DASHBOARD_URL=http://dashboard.localhost:3000

# Playwright (use a dedicated local or staging test account)
E2E_USER_EMAIL=customer@example.com
E2E_USER_PASSWORD=change-me
