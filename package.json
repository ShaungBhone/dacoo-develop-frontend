{
  "name": "dacoo-frontend",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/dashboard dev",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "dev:docs": "bun run --cwd apps/docs dev",
    "dev:marketing": "bun run --cwd apps/marketing dev",
    "build": "bun run build:dashboard && bun run build:docs && bun run build:marketing",
    "build:dashboard": "bun run --cwd apps/dashboard build",
    "build:docs": "bun run --cwd apps/docs build",
    "build:marketing": "bun run --cwd apps/marketing build",
    "lint": "bun run lint:dashboard && bun run lint:docs && bun run lint:marketing",
    "lint:dashboard": "bun run --cwd apps/dashboard lint",
    "lint:docs": "bun run --cwd apps/docs lint",
    "lint:marketing": "bun run --cwd apps/marketing lint",
    "typecheck": "bun run typecheck:dashboard && bun run typecheck:docs && bun run typecheck:marketing",
    "typecheck:dashboard": "bun run --cwd apps/dashboard typecheck",
    "typecheck:docs": "bun run --cwd apps/docs typecheck",
    "typecheck:marketing": "bun run --cwd apps/marketing typecheck",
    "test": "bun run --cwd apps/dashboard test && bun run --cwd apps/docs test",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
